{
  "name": "brawl-picks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Best Brawl Stars brawlers for each map, searchable by map initials.",
  "scripts": {
    "data": "node scripts/fetch-data.mjs",
    "rotation": "node scripts/fetch-rotation.mjs",
    "dev": "node scripts/serve.mjs",
    "demo": "node scripts/demo-data.mjs && node scripts/serve.mjs --demo",
    "test": "node --test test/*.test.mjs worker/test/*.test.mjs",
    "pull-data": "git fetch origin data && git archive FETCH_HEAD | tar -x",
    "ux-check": "cd tools/ux-check && node check.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
